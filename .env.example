# AI Power Job Portal Environment Configuration

# Base URL for the backend API server (Node.js/Express, Spring Boot, Django, FastAPI, etc.)
VITE_API_BASE_URL=http://localhost:5000/api

# Set to 'true' to use hardcoded/mock data with simulated network latency.
# Set to 'false' to connect directly to the live backend API server.
VITE_USE_MOCK_DATA=true

# Optional: Disable HMR in specialized IDE sandbox environments
# DISABLE_HMR=true
